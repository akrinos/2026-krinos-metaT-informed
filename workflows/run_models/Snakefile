rule allometry_bats_hot:
    output:
        output_file = os.path.join(OUTPUTDIR,"allometry","bats_hot","model_output.csv")
    resources:
        runtime=1000,
        mem_mb="5gb"
    run:
        import model_functions
        params_frame = create_params_frame("allom",model_functions.organisms_for_model)
        import read_in_bats_hot
        from read_in_bats_hot import nutrient_data_all,temp_data_all
        combined_sol = pd.DataFrame()
        
        for stat_id in list(set(nutrient_data_all["site"])):
            sub_frame=nutrient_data_all.loc[nutrient_data_all["site"]==stat_id,:]
            sub_frame_temp_=temp_data_all.loc[temp_data_all["site"]==stat_id,:]
            if len(sub_frame_temp_.index)==0:
                continue
            time_vect = pd.date_range(np.min(sub_frame.DateTime),
                                      np.max(sub_frame.DateTime), freq='D')

            f_nearest = interp1d(sub_frame.DateTime.astype('int64'), 
                                 sub_frame.nitrogen, 
                                 kind='nearest', fill_value="extrapolate")
            convert_frame=pd.DataFrame({"DateTime":time_vect})
            convert_frame["nitrogen"] = f_nearest(time_vect.astype('int64'))
            f_nearest = interp1d(sub_frame.DateTime.astype('int64'), 
                                 sub_frame.phosphorus, 
                                 kind='nearest', fill_value="extrapolate")
            convert_frame["phosphorus"] = f_nearest(time_vect.astype('int64'))

            sub_frame_temp=pd.DataFrame({"DateTime":time_vect})
            f_nearest = interp1d(sub_frame_temp_.DateTime.astype('int64'), 
                                 sub_frame_temp_.temp, 
                                 kind='nearest', fill_value="extrapolate")
            sub_frame_temp["temperature_daily"] = f_nearest(time_vect.astype('int64'))

            dates_with_index = pd.DataFrame(time_vect,columns=["DateTime"]).reset_index()
            nitr_with_index = convert_frame.merge(dates_with_index,on="DateTime",how="inner")
            phos_with_index = convert_frame.merge(dates_with_index,on="DateTime",how="inner")
            sub_frame_temp = sub_frame_temp.merge(dates_with_index,on="DateTime",how="inner")

            ## initial state defaults
            state={}
            for org in organisms_for_model:
                state[org]=0.5
            state["zoop"]=0.5

            #update_interval=15 # update every 15 days
            total_steps=len(time_vect)-1
            for i in range(0, total_steps-total_steps%update_interval-1, update_interval):
                ## get N + P values currently
                state["nitrogen"]=nitr_with_index.nitrogen[i]
                state["phosphorus"]=phos_with_index.phosphorus[i]
                sol = run_ivp_interval(state,
                         time_vect,update_interval,i,
                         organisms_for_model,params_frame,sub_frame_temp)

                state=update_state_dict(state,sol)
                all_sol = create_phyto_frame(sol,stat_id,dates_with_index)

                combined_sol = pd.concat([combined_sol,all_sol],axis=0)
            
        combined_sol.to_csv(output.output_file)


