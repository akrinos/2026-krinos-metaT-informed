from model_functions import *

# model_outputs_4: alpha = 2
# model_outputs_5: alpha = 1.25
# model_outputs_6: alpha = 1
# model_outputs_7: alpha = 1.5
# model_outputs_8: alpha = 1.25; graz_max = 0.2
# model_outputs_9: alpha = 1.25; graz_max = 0.8
# model_outputs_10: alpha = 1.25; graz_max = 0.5
# model_outputs_11: alpha = 1.25; graz_max = 0.5, haldane w/ half_sat = inhibition
# model_outputs_12: alpha = 1.25; graz_max = 0.5, haldane w/ 4*half_sat = inhibition
# model_outputs_13: alpha = 1.25; graz_max = 0.5
# model_outputs_14: alpha = 1.25; graz_max = 0.5, new scaling of mu_max based on K_max distance from mean with 0.5 param.
# model_outputs_15: alpha = 1.25; graz_max = 0.5, new scaling of mu_max based on K_max distance from mean with 0.9 param
# model_outputs_16: alpha = 1.25; graz_max = 0.5, update interval 30

update_interval=30

OUTPUTDIR = os.path.join("model_outputs_16")
def get_max_gr(taxon):
    return float(scaling_relationships.loc[scaling_relationships.taxon==taxon,"max_growth_rate"])

def create_params_frame(allom_or_metaT,organisms_for_model):
    consistent_max_gr = 1
    params_frame={}
    gamma = 0.5 # how dramatically to scale max growth rate by distance from mean, higher values indicate more of a penalty for low half-sat.
    
    all_half_sats_n=[]
    all_half_sats_p=[]
    for organism in organisms_for_model:
        all_half_sats_n.append(get_half_sat(organism,"N",allom_or_metaT))
        all_half_sats_p.append(get_half_sat(organism,"P",allom_or_metaT))
        
    mean_p = np.mean(all_half_sats_p)
    mean_n = np.mean(all_half_sats_n)
    for organism in organisms_for_model:
        half_sat_nitr = get_half_sat(organism,"N",allom_or_metaT)
        half_sat_phos = get_half_sat(organism,"P",allom_or_metaT)
        if half_sat_nitr == "not_found":
            half_sat_nitr = consistent_half_sat_nitr
        if half_sat_phos == "not_found":
            half_sat_phos = consistent_half_sat_phos
        max_gr=consistent_max_gr * (1+gamma * np.mean([(half_sat_phos-mean_p)/mean_p,(half_sat_nitr-mean_n)/mean_n])) # if half_sat_phos and half_sat_nitr both equal the mean, consistent_max_gr will be used.

        current_org_dict={"max_gr":get_max_gr(organism),
                          "half_sat_nitr":half_sat_nitr,
                          "half_sat_phos":half_sat_phos,
                          "T_opt":get_temp_params(organism,"mean"),
                          "std_T":get_temp_params(organism,"std")}
        params_frame[organism]=current_org_dict
    return params_frame
  
def run_ivp_interval(state,
                     time_vect,update_interval,i,
                     organisms_for_model,params_frame,sub_frame_temp):
    sol = solve_ivp(transporter_model_all_resource, t_span=[i,i+update_interval-1],
                        t_eval=list(range(i,i+update_interval-1,1)),
                        first_step=0.01,
                        y0=list(state.values()),args=[organisms_for_model,params_frame,
                        time_vect,sub_frame_temp])
    return sol

def create_phyto_frame(sol,stat_id,dates_with_index):
    phyto_frame=pd.DataFrame()
    for organism,organism_ind in zip(organisms_for_model,range(len(organisms_for_model))):
        phyto_frame[organism] = sol.y[organism_ind,:]
    phyto_frame["index"]=sol.t
    phyto_frame["zoop"] = list(sol.y[sol.y.shape[0]-3,:])
    phyto_frame["nitrogen"] = list(sol.y[sol.y.shape[0]-2,:]) #n_values
    phyto_frame["phosphorus"] = list(sol.y[sol.y.shape[0]-1,:]) #p_values
        
    all_sol = phyto_frame.merge(dates_with_index,on="index").melt(id_vars=["DateTime","index"],
                     var_name="taxon",value_name="abund")

    all_sol["Site"] = stat_id
    return all_sol
    
def update_state_dict(state,sol):
    for organism,organism_ind in zip(organisms_for_model,range(len(organisms_for_model))):
        if sol.y[organism_ind,sol.y.shape[1]-1] > 0:
            state[organism] = sol.y[organism_ind,sol.y.shape[1]-1]
        else:
            state[organism] = 0
    if sol.y[sol.y.shape[0]-3,sol.y.shape[1]-1] > 0:
        state["zoop"] = sol.y[sol.y.shape[0]-3,sol.y.shape[1]-1]
    else:
        state["zoop"] = 0
    
    return state

rule all:
    input:
        allometry = os.path.join(OUTPUTDIR,"allometry","ccb","model_output.csv"),
        metaT = os.path.join(OUTPUTDIR,"metaT_informed","ccb","model_output.csv"),
        allom_BH = os.path.join(OUTPUTDIR,"allometry","bats_hot","model_output.csv"),
        metaT_BH = os.path.join(OUTPUTDIR,"metaT_informed","bats_hot","model_output.csv"),
        allom_NERRS = os.path.join(OUTPUTDIR,"allometry","nerrs","model_output.csv"),
        metaT_NERRS = os.path.join(OUTPUTDIR,"metaT_informed","nerrs","model_output.csv")

rule allometry_model_old:
    output:
        output_file = os.path.join(OUTPUTDIR,"allometry","ccb","model_output_old.csv")
    resources:
        runtime=1000,
        mem_mb="5gb"
    run:
        import model_functions
        import read_in_ptown_data
        from read_in_ptown_data import nitr,ammon,phos,daily_temp_fr_2
        params_frame = create_params_frame("allom",model_functions.organisms_for_model)
        stat_id = "ccb"
        combined_sol = pd.DataFrame()
        
        ## SET MODEL RUNTIMES
        time_vect = pd.date_range(datetime.strptime('2000-02-01 00:00',"%Y-%m-%d %H:%M"),
                          datetime.strptime("2023-10-29 00:00","%Y-%m-%d %H:%M"), freq='D')

        dates_with_index = pd.DataFrame(time_vect,columns=["DateTime"]).reset_index()
        nitr_with_index = nitr.merge(dates_with_index,on="DateTime",how="inner")
        ammon_with_index = ammon.merge(dates_with_index,on="DateTime")
        phos_with_index = phos.merge(dates_with_index,on="DateTime",how="inner")
        temp_with_index = daily_temp_fr_2.merge(dates_with_index,on="DateTime",how="inner")

        ## initial state defaults
        state={}
        for org in organisms_for_model:
            state[org]=0.5
        state["zoop"]=0.5
        
        #update_interval=15 # update every 15 days
        total_steps=len(time_vect)-1
        for i in range(0, total_steps-total_steps%update_interval-1, update_interval):
            ## get N + P values currently
            state["nitrogen"]=nitr_with_index.nitrogen[i]
            state["phosphorus"]=phos_with_index.phosphorus[i]
            sol = run_ivp_interval(state,
                     time_vect,update_interval,i,
                     organisms_for_model,params_frame,temp_with_index)
                     
            state=update_state_dict(state,sol)
            all_sol = create_phyto_frame(sol,stat_id,dates_with_index)
            
            combined_sol = pd.concat([combined_sol,all_sol],axis=0)
            
        combined_sol.to_csv(output.output_file)
 
